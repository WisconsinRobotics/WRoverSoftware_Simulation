<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- General Definitions -->
    <xacro:property name="leg_main_shaft_length" value = "0.4"/>
    <xacro:property name="leg_main_shaft_radius" value = "0.05"/>

    <xacro:property name="wheel_radius" value = "0.15"/>
    <xacro:property name="wheel_length" value = "0.24"/>

    <xacro:macro name = "make_leg" params = "prefix x_offset y_offset z_offset">
        <!-- Main Leg Stem -->
        <link name = "${prefix}_leg" >
            <visual>
                <pose xyz="0 0 0"/>
                <geometry>
                    <cylinder radius = "${leg_main_shaft_radius}" length = "${leg_main_shaft_length}" />
                </geometry>
            </visual>
            <collision>
                <pose xyz="0 0 0"/>
                <geometry>
                    <cylinder radius = "${leg_main_shaft_radius}" length = "${leg_main_shaft_length}" />
                </geometry>
            </collision>
            <!-- ## ADD INERTIA TAG HERE ## -->
        </link>

        <!-- Main Wheel -->
        <link name = "${prefix}_wheel" >
            <visual>
                <origin rpy="1.57075 1.57075 0"/>
                <geometry>
                    <cylinder radius = "${wheel_radius}" length = "${wheel_length}" />
                </geometry>
            </visual>
            <collision>
                <origin rpy="1.57075 1.57075 0"/>
                <geometry>
                    <cylinder radius = "${wheel_radius}" length = "${wheel_length}" />
                </geometry>
            </collision>
            <!-- ## ADD INERTIA TAG HERE ## -->
        </link>


        <!-- JOINTS -->
        <joint name = "${prefix}_leg_to_body" type="revolute">
            <parent link="body"/>
            <child link="${prefix}_leg"/>
            <axis xyz="0 0 1"/>
            <limit effort = "30" velocity = "1.0" lower="-1.57" upper="1.57"/>
            <origin xyz="${x_offset} ${y_offset} ${-leg_main_shaft_length/2}" rpy="0 0 0"/>
        </joint>
        <joint name = "${prefix}_wheel_to_leg" type="revolute">
            <parent link="${prefix}_leg"/>
            <child link="${prefix}_wheel"/>
            <axis xyz="0 1 0"/>
            <limit effort = "30" velocity = "1.0" lower="-1.57" upper="1.57"/>
            <origin xyz="0 0 ${-leg_main_shaft_length/2 + wheel_radius/2}"/>
        </joint>
    </xacro:macro>
</robot>
